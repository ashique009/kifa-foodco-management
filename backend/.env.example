# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration
# Option 1: Full connection string (Recommended for Neon / Render)
# DATABASE_URL=postgresql://username:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Option 2: Individual variables (Local development fallback)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bakery_management
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# Security
JWT_SECRET=your_strong_jwt_secret_key_here

# CORS: Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=https://your-frontend-subdomain.pages.dev,http://localhost:5173
